# =========================================
# Python / venv
# =========================================
__pycache__/
.venv/
*.pyc

# =========================================
# Local environment
# =========================================
.env
*.log

# =========================================
# Raw / Big data
# → raw は基本 ignore、ただし *_Numbers3features.csv だけ Git 管理
# =========================================

# まず raw を全部 ignore
data/raw/**

# ★ Numbers3features の履歴 CSV だけ許可（毎回ファイル名が変わってもOK）
!data/raw/*_Numbers3features.csv

# raw_fixed も ignore
data/raw_fixed/**

# =========================================
# Model files（巨大） → 常に除外
# =========================================
artifacts/models*/
artifacts/**/models*/
artifacts/**/*.joblib
*.joblib
*.pkl
*.onnx

# =========================================
# artifacts 配下の制御
# → 基本 ignore
# → outputs/ の CSV だけ Git 管理
# =========================================

# 全部 ignore
artifacts/*

# outputs/ は Git 管理
!artifacts/outputs/

# outputs の CSV も管理
!artifacts/outputs/*.csv

# =========================================
# OS generated files
# =========================================
.DS_Store
Thumbs.db
